; Tiraspol / Balka — Godot 4.4.1 Compatibility
config_version=5

[application]
config/name="GTA Tiraspol"
config/version="0.2.0"
config/icon="res://assets/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Лёгкая 3D-песочница: Тирасполь, Балка."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.58, 0.72, 0.79, 1)
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
